# Dedicated server-side secret shared only with Application Management.
# Use a random value of at least 32 characters. Never expose it through NEXT_PUBLIC_*.
RU_LIFE_CONTROL_SERVICE_SECRET=replace-with-a-dedicated-ru-life-secret-at-least-32-chars

# Exact Application Management origin allowed to use browser admin tickets.
# Production/preview must use HTTPS. Local loopback HTTP is accepted only when LOCAL_CONTROL_PLANE=true.
APPLICATION_MANAGEMENT_ORIGIN=https://application-management.example.com

# Local development only. Do not enable this in Cloudflare preview/production.
LOCAL_CONTROL_PLANE=false

# D1 database id owned by the selected RU_LIFE environment.
# Local may use the dedicated placeholder in wrangler.local.jsonc; preview/production must set their own real D1 IDs outside the repo.
RU_LIFE_DATABASE_ID=replace-with-ru-life-d1-id-for-this-environment
