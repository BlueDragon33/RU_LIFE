# Public API origin of Application Management.
NEXT_PUBLIC_APPLICATION_MANAGEMENT_BASE_URL=https://learning-management.boiech-ai.workers.dev

# Must exactly match RU_LIFE_CONTROL_SERVICE_SECRET in Application Management.
# Use a random value of at least 32 characters. Never expose it through NEXT_PUBLIC_*.
RU_LIFE_CONTROL_SERVICE_SECRET=replace-with-a-dedicated-ru-life-secret-at-least-32-chars
