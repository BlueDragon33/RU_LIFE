# Dedicated server-side secret shared only with Application Management.
# Use a random value of at least 32 characters. Never expose it through NEXT_PUBLIC_*.
RU_LIFE_CONTROL_SERVICE_SECRET=replace-with-a-dedicated-ru-life-secret-at-least-32-chars

# Only this origin may use the browser admin ticket against /api/control/*.
APPLICATION_MANAGEMENT_ORIGIN=https://learning-management.boiech-ai.workers.dev

# Production Cloudflare D1 database id owned by RU_LIFE.
# CI/local builds may use a non-production placeholder binding; production must set the real id.
RU_LIFE_DATABASE_ID=replace-with-ru-life-production-d1-id
