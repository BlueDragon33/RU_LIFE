  "topicSlug": "insurance",
  "title": "Bảo hiểm · hồ sơ y tế",
  "summary": "Biết mình có loại bảo hiểm nào, cơ sở nào thuộc phạm vi sử dụng và đầu mối cần gọi; không suy đoán quyền lợi chỉ từ tên gói bảo hiểm.",
  "provenance": {
    "sourceIds": [
      "source:ru:health:insurance:studyinrussia",
      "source:ru:health:insurance:gov631"
    ],
    "verifiedAt": "2026-10-07",
    "freshness": "verified"
  },
  "semantics": {
    "mainIdea": {
      "id": "insurance:idea:navigate",
      "text": "Bảo hiểm là công cụ điều hướng chăm sóc theo kế hoạch; quyền lợi và mạng lưới phải được xác minh theo đúng policy của bạn.",
      "sourceIds": [
        "source:ru:health:insurance:studyinrussia"
      ]
    },
    "purpose": {
      "id": "insurance:purpose:avoid-delay",
      "text": "Giúp chuẩn bị hồ sơ và đầu mối trước khi cần khám, đồng thời không để việc tìm policy làm chậm cấp cứu.",
      "sourceIds": [
        "source:ru:health:insurance:studyinrussia",
        "source:ru:health:insurance:gov631"
      ]
    },
    "rationale": [
      {
        "id": "insurance:rationale:network",
        "text": "Cơ sở và quyền lợi có thể khác theo chương trình bảo hiểm; không mặc định mọi bệnh viện đều áp dụng cùng điều kiện.",
        "sourceIds": [
          "source:ru:health:insurance:studyinrussia"
        ]
      }
    ],
    "logic": [
      {
        "id": "insurance:logic:planned",
        "text": "Khi khám theo kế hoạch, kiểm tra mạng lưới, hotline/đặt lịch và phần được bảo hiểm thanh toán trước khi đi.",
        "sourceIds": [
          "source:ru:health:insurance:studyinrussia"
        ]
      },
      {
        "id": "insurance:logic:emergency",
        "text": "Chăm sóc cấp cứu khi có tình trạng đe dọa tính mạng là luồng riêng; quy định hiện hành nêu cấp cứu cho người nước ngoài được cung cấp miễn phí.",
        "sourceIds": [
          "source:ru:health:insurance:gov631"
        ],
        "scope": "Quyền lợi điều trị tiếp theo sau giai đoạn cấp cứu có thể phụ thuộc bảo hiểm, hợp đồng dịch vụ và tình trạng pháp lý."
      }
    ],
    "preconditions": [
      {
        "id": "insurance:precondition:policy",
        "text": "Bạn có hoặc đang xác định policy/bảo hiểm đang sử dụng.",
        "sourceIds": []
      }
    ],
    "scope": [
      {
        "id": "insurance:scope:no-benefit-inference",
