    "mainIdea": {
      "id": "housing:idea:separate",
      "text": "Nhận phòng và thủ tục cư trú là hai luồng khác nhau; chỗ ở phải có thông tin bàn giao/đầu mối, còn đăng ký nơi lưu trú phải theo quy trình riêng.",
      "sourceIds": [
        "source:ru:daily:housing:studyinrussia"
      ]
    },
    "purpose": {
      "id": "housing:purpose:stable",
      "text": "Giúp ổn định nơi ở, ghi nhận tình trạng phòng và không bỏ sót đầu mối/thủ tục sau khi đến.",
      "sourceIds": [
        "source:ru:daily:housing:studyinrussia"
      ]
    },
    "rationale": [],
    "logic": [
      {
        "id": "housing:logic:before",
        "text": "Trước khi nhận phòng, xác nhận địa chỉ, giờ làm việc, đầu mối, giấy tờ và khoản thanh toán theo chính trường/chỗ ở.",
        "sourceIds": [
          "source:ru:daily:housing:studyinrussia"
        ]
      },
      {
        "id": "housing:logic:separate",
        "text": "Được nhận phòng không chứng minh đăng ký nơi lưu trú/cư trú đã hoàn tất; phải hỏi đầu mối sinh viên quốc tế/ký túc xá về luồng đó.",
        "sourceIds": [
          "source:ru:daily:housing:studyinrussia"
        ]
